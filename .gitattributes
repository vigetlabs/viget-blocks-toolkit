# Compiled assets. Generated by `npm run build` — collapsed in pull request
# diffs and excluded from language statistics.
build/** linguist-generated=true
languages/*.pot linguist-generated=true

# Keep development files out of the Composer/GitHub zipball. src/classes is
# runtime PHP and has to stay; everything else under src/ is build source.
/.github export-ignore
/bin export-ignore
/src/features export-ignore
/src/*.js export-ignore
/src/*.scss export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.phpcs.xml export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/packages.json export-ignore
/prettier.config.js export-ignore
/webpack.config.js export-ignore
/assets/screenshot-1.png export-ignore
/assets/screenshot-2.png export-ignore
/assets/screenshot-3.gif export-ignore
