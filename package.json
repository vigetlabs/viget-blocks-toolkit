{
  "name": "viget-blocks-toolkit",
  "version": "1.1.9",
  "description": "Custom Block support and button icons.",
  "author": "Viget",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:js:src": "wp-scripts lint-js ./src",
    "lint:js:src:fix": "wp-scripts lint-js ./src --fix",
    "start": "wp-scripts start",
    "packages-update": "wp-scripts packages-update",
    "update-pot": "wp i18n make-pot . languages/viget-blocks-toolkit.pot",
    "format": "prettier \"./src/**/*.{css,ts,tsx,js}\" --check",
    "format:fix": "prettier \"./src/**/*.{css,ts,tsx,js}\" --write",
    "version": "node bin/sync-version.js && git add viget-blocks-toolkit.php readme.txt",
    "postversion": "git push && git push --tags",
    "release": "npm version"
  },
  "dependencies": {
    "@wordpress/dom-ready": "^4.55.0",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^13.4.0",
    "@wordpress/blocks": "^13.10.0",
    "@wordpress/components": "^28.13.0",
    "@wordpress/compose": "^7.46.0",
    "@wordpress/data": "^10.55.0",
    "@wordpress/edit-post": "^8.55.0",
    "@wordpress/edit-site": "^6.50.0",
    "@wordpress/element": "^6.46.0",
    "@wordpress/hooks": "^4.55.0",
    "@wordpress/i18n": "^5.26.0",
    "@wordpress/scripts": "^35.0.0",
    "prettier": "^3.9.8",
    "webpack-remove-empty-scripts": "^1.1.1"
  }
}
